#!/usr/bin/env python3
"""Run the Hermes Stats CLI from a checkout: `bin/hermes-stats serve --port 8800`, `snapshot FILE`, `insights`.

Stdlib only. It reads $HERMES_HOME (default ~/.hermes). Summaries from a checkout need --llm-url; installed,
`hermes stats ...` uses your Hermes auxiliary model (auxiliary.stats_insights).
"""
import argparse
import importlib.util
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
spec = importlib.util.spec_from_file_location(
    "hermes_stats", ROOT / "__init__.py", submodule_search_locations=[str(ROOT)])
plugin = importlib.util.module_from_spec(spec)
sys.modules["hermes_stats"] = plugin
spec.loader.exec_module(plugin)

parser = argparse.ArgumentParser(prog="hermes-stats", description="Hermes Stats")
plugin._cli_setup(parser)
sys.exit(plugin._cli(parser.parse_args()))
